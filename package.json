{
  "name": "headroom",
  "version": "0.4.0-beta.1",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/check-platform.js && electron .",
    "test": "node --test",
    "dist": "electron-builder --mac --arm64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "tools:prepare": "node scripts/prepare-tools.js",
    "preview:mac": "electron-builder --mac --arm64 --dir --publish never --config.electronDist=node_modules/electron/dist"
  },
  "keywords": [],
  "author": "Marat-ctrl",
  "license": "MIT",
  "description": "HeadRoom music player, based on Riff by rootscripts.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {},
  "productName": "HeadRoom",
  "build": {
    "appId": "app.headroom.player",
    "productName": "HeadRoom",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": ".tool-bundles/darwin-${arch}/bin",
          "to": "bin"
        }
      ]
    },
    "publish": null,
    "afterPack": "scripts/mac-adhoc-sign.js",
    "beforePack": "scripts/prepare-tools.js"
  },
  "headroom": {
    "upstream": "https://github.com/rootscripts/riff",
    "upstreamVersion": "44.2.0",
    "updatesEnabled": false
  }
}
